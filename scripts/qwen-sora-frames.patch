@@ -445,0 +470,7 @@ static int run(const Args & a) {
+                        if (a.sora_frames) {
+                            const char end[4] = {};
+                            if (fwrite(end, 1, sizeof(end), stdout) != sizeof(end) || fflush(stdout) != 0) {
