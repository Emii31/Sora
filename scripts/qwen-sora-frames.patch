diff --git a/tools/qwen-tts.cpp b/tools/qwen-tts.cpp
index c8fd73f..b2a7a91 100644
--- a/tools/qwen-tts.cpp
+++ b/tools/qwen-tts.cpp
@@ -96,0 +97 @@ struct Args {
+    bool         sora_frames;
@@ -185,0 +187 @@ static bool parse_args(int argc, char ** argv, Args & a) {
+    a.sora_frames     = false;
@@ -244,0 +247,2 @@ static bool parse_args(int argc, char ** argv, Args & a) {
+        } else if (std::strcmp(arg, "--sora-frames") == 0) {
+            a.sora_frames = true;
@@ -357,0 +362,5 @@ static int run(const Args & a) {
+    if (a.sora_frames && (!line_mode || wav_fmt != WAV_S16)) {
+        fprintf(stderr, "[CLI] ERROR: --sora-frames requires line streaming and 16-bit PCM\n");
+        qt_free(q);
