+                char size[4];
+                char * cursor = size;
+                wav_write_u32le(cursor, (uint32_t) n * 2);
+                return fwrite(size, 1, sizeof(size), stdout) == sizeof(size) &&
+                       wav_stream_write((wav_stream *) ud, samples, n);
+            };
+        }
@@ -429 +453 @@ static int run(const Args & a) {
