+    }
@@ -392 +401,6 @@ static int run(const Args & a) {
-        if (!wav_stream_open_stdout(&ws, 24000, wav_fmt)) {
+        if (a.sora_frames) {
+            ws = {stdout, WAV_S16, 24000};
+#if defined(_WIN32)
+            _setmode(_fileno(stdout), _O_BINARY);
