  "usb_warmed_trials": [
    {
      "warmup_s": 4.136079499000061,
      "turns": [
        {
          "style": "playful-0",
          "lines": [
            "Wait, did you actually keep it? That little note was just me being silly."
          ],
          "first_chunk_s": 0.6386318939999001,
          "continuous_audible_s": 0.8332568939999001,
          "generation_s": 1.6384041339997566,
          "audio_s": 4.672,
          "chunks": 2
        },
        {
          "style": "playful-1",
          "lines": [
            "You really kept that little note? I wrote it on a napkin because I'd run out of paper. That's so sweet. Now I'm going to be smiling about it all day."
          ],
          "first_chunk_s": 0.794846459999917,
          "continuous_audible_s": 1.0365840590001898,
          "generation_s": 4.108934684999895,
          "audio_s": 9.173333333333334,
          "chunks": 3
        },
        {
          "style": "tender-0",
          "lines": [
            "Hey, I'm here. Take your time and tell me when you're ready."
          ],
          "first_chunk_s": 0.6354242900001736,
          "continuous_audible_s": 0.872632623333507,
          "generation_s": 1.3720395229997848,
          "audio_s": 4.16,
          "chunks": 2
        },
        {
          "style": "tender-1",
          "lines": [
            "Hey, come here for a second. You've been carrying a lot today. You don't have to explain any of it right now. I can sit with you until you're ready."
          ],
          "first_chunk_s": 0.7797138789997007,
          "continuous_audible_s": 0.9595888789997007,
          "generation_s": 2.780826968999918,
          "audio_s": 9.472,
          "chunks": 3
        },
        {
          "style": "sad-0",
          "lines": [
            "I missed you today. It was a little too quiet here."
          ],
          "first_chunk_s": 0.4315532769996935,
          "continuous_audible_s": 0.6191366103330268,
          "generation_s": 1.0928728069998215,
          "audio_s": 3.562666666666667,
          "chunks": 2
        },
        {
          "style": "sad-1",
          "lines": [
            "I thought you'd be here this evening. I kept looking at the clock, and every time I heard a door close I thought it might be you."
          ],
          "first_chunk_s": 0.4995834690002994,
          "continuous_audible_s": 0.6571251356669661,
          "generation_s": 2.1217997439998726,
          "audio_s": 7.978666666666666,
          "chunks": 3
        },
        {
          "style": "angry-0",
          "lines": [
            "Please hear me out. I don't want to have this same fight again."
          ],
          "first_chunk_s": 0.49065850099987074,
          "continuous_audible_s": 0.6447835009998708,
          "generation_s": 1.1232874890001767,
          "audio_s": 3.776,
          "chunks": 2
        },
        {
          "style": "angry-1",
          "lines": [
